# ComTrak Backend Configuration
HOST=0.0.0.0
PORT=8080
DATA_DIR=/data
DATABASE_URL=sqlite:/data/comtrak.db?mode=rwc

# Garage S3 Configuration
GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_REGION=garage
GARAGE_BUCKET=comtrak-media
GARAGE_ACCESS_KEY=GKtestkey0000000000000000
GARAGE_SECRET_KEY=testsecret00000000000000000000000000000000

# Auth Configuration
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-chars-long
GOOGLE_CLIENT_ID=your-google-oauth2-client-id.apps.googleusercontent.com

# Logging
RUST_LOG=info,comtrak_backend=debug
